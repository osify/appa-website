---
/**
 * A leadership profile.
 *
 * `featured` renders the wide dark card used for the Chairman; everything else
 * renders as a sand tile. Until a photograph is supplied (photo: "" in
 * src/data/leadership.json) the card shows a monogram, which looks intentional
 * rather than broken.
 */
import type { CollectionEntry } from 'astro:content';
import { pick, pickList, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  person: CollectionEntry<'leadership'>;
  /** Show qualifications and memberships in full — used on /leadership. */
  detailed?: boolean;
}

const { lang, person, detailed = false } = Astro.props;
const t = useTranslations(lang);

const { featured, initials, photo } = person.data;
const name = pick(person.data.name, lang);
const role = pick(person.data.role, lang);
const bio = pick(person.data.bio, lang);
const qualifications = pickList(person.data.qualifications, lang);
const memberships = pickList(person.data.memberships, lang);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

{
  featured ? (
    <article class="reveal relative flex flex-col items-start gap-8 overflow-hidden rounded-3xl bg-navy-900 p-8 sm:col-span-2 sm:flex-row lg:p-10">
      <div class="barcode barcode-soft absolute bottom-0 right-0 h-24 w-full text-gold-500 opacity-[0.06]" />

      <div class="shrink-0">
        {photo ? (
          <img
            src={`${base}${photo}`}
            alt={name}
            class="h-28 w-28 rounded-2xl object-cover"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="flex h-28 w-28 items-center justify-center rounded-2xl bg-slate-500">
            <span aria-hidden="true" class="font-serif text-3xl font-semibold text-white">
              {initials}
            </span>
          </div>
        )}
      </div>

      <div class="relative">
        <p class="microlabel text-[10px] font-bold uppercase tracking-[0.18em] text-gold-500">
          {role}
        </p>
        <h3 class="mt-2 font-serif text-2xl font-semibold text-white lg:text-3xl">{name}</h3>
        <p class="mt-4 leading-relaxed text-white/60">{bio}</p>

        {detailed && qualifications.length > 0 && (
          <div class="mt-6">
            <h4 class="microlabel mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-white/35">
              {t('leadership.qualifications')}
            </h4>
            <ul class="space-y-1 text-sm text-white/60">
              {qualifications.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {memberships.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {memberships.map((item) => (
              <li class="rounded-full border border-gold-500/30 px-3 py-1 text-[11px] font-medium text-gold-300">
                {item}
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  ) : (
    <article class="reveal group rounded-3xl border border-navy-900/[0.05] bg-sand p-8 transition-all hover:-translate-y-1 hover:shadow-xl">
      {photo ? (
        <img
          src={`${base}${photo}`}
          alt={name}
          class="mb-6 h-20 w-20 rounded-2xl object-cover"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-slate-500">
          <span aria-hidden="true" class="font-serif text-xl font-semibold text-white">
            {initials}
          </span>
        </div>
      )}

      <p class="microlabel text-[10px] font-bold uppercase tracking-[0.18em] text-gold-600">{role}</p>
      <h3 class="mt-2 font-serif text-xl font-semibold">{name}</h3>
      <p class="mt-4 text-sm leading-relaxed text-slate-500">{bio}</p>

      {detailed && qualifications.length > 0 && (
        <div class="mt-5 border-t border-navy-900/[0.07] pt-4">
          <h4 class="microlabel mb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">
            {t('leadership.qualifications')}
          </h4>
          <ul class="space-y-1 text-sm text-slate-500">
            {qualifications.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )}

      {memberships.length > 0 && (
        <p class="mt-5 border-t border-navy-900/[0.07] pt-4 text-[11px] text-slate-400">
          {memberships.join(' · ')}
        </p>
      )}
    </article>
  )
}
