---
/**
 * The site's whole icon set, inlined as SVG paths.
 *
 * Inline SVG rather than an icon font or a sprite sheet: there is no extra
 * request, the icons inherit `currentColor`, and they cannot flash unstyled.
 * Add a new icon by adding one entry to `PATHS`.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-left'
  | 'menu'
  | 'close'
  | 'chevron-down'
  | 'map-pin'
  | 'phone'
  | 'mail'
  | 'calendar'
  | 'clock'
  | 'globe'
  | 'database'
  | 'shield-check'
  | 'users'
  | 'building'
  | 'facebook'
  | 'linkedin'
  | 'telegram'
  | 'external';

interface Props {
  name: IconName;
  class?: string;
  /** Icons are decorative by default; pass a label to expose one to screen readers. */
  label?: string;
}

const { name, class: className = 'w-5 h-5', label } = Astro.props;

/** Icons drawn with strokes — they inherit stroke-width and line caps. */
const STROKE: Partial<Record<IconName, string>> = {
  'arrow-right': '<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/>',
  'arrow-left': '<path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6"/>',
  menu: '<path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>',
  'chevron-down': '<path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>',
  'map-pin':
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  phone:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6"/>',
  calendar:
    '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path stroke-linecap="round" d="M3 9h18M8 3v3M16 3v3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3.5 2"/>',
  globe:
    '<circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18"/>',
  database:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7Z"/><path stroke-linecap="round" d="M8 10h8M8 14h5"/>',
  'shield-check':
    '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/>',
  users:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M17 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9.5" cy="7" r="3.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M22 20v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/>',
  building:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V8l7-5 7 5v13"/><path stroke-linecap="round" d="M10 21v-6h4v6"/>',
  external:
    '<path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4"/>',
};

/** Icons drawn as solid shapes — brand marks, which have no stroke version. */
const FILL: Partial<Record<IconName, string>> = {
  facebook: '<path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z"/>',
  linkedin:
    '<path d="M6.94 8.5H4.06V20h2.88V8.5ZM5.5 7.2a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4ZM20 13.6c0-3-1.6-4.4-3.8-4.4-1.7 0-2.5.95-2.95 1.62V8.5H10.4c.04.8 0 11.5 0 11.5h2.85v-6.42c0-.3.02-.6.11-.82.25-.6.8-1.23 1.74-1.23 1.23 0 1.72.93 1.72 2.3V20H20v-6.4Z"/>',
  telegram:
    '<path d="M21.2 4.4 2.9 11.3c-.9.35-.9.9-.16 1.13l4.7 1.47 1.8 5.5c.22.6.4.83 1 .83.47 0 .68-.21.94-.47l2.26-2.2 4.7 3.47c.86.48 1.48.23 1.7-.8l3.05-14.4c.31-1.26-.48-1.83-1.7-1.43ZM8.9 14.3l10.2-6.4c.5-.3.96-.14.58.2l-8.73 7.88-.34 3.63L8.9 14.3Z"/>',
};

const path = STROKE[name] ?? FILL[name] ?? '';
const isFilled = Boolean(FILL[name]);
---

{
  isFilled ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      set:html={path}
    />
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      set:html={path}
    />
  )
}
