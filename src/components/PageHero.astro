---
/**
 * The dark banner that opens every page except the homepage — page title,
 * standfirst and a breadcrumb back up the tree.
 */
import Icon from './Icon.astro';
import { path, useTranslations, type Locale } from '../i18n/utils';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Locale;
  eyebrow?: string;
  title: string;
  titleHtml?: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { lang, eyebrow, title, titleHtml, lead, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-navy-900 pt-32 pb-16 lg:pt-44 lg:pb-24">
  <div class="barcode barcode-soft pointer-events-none absolute right-0 top-0 h-full w-1/3 text-gold-500 opacity-[0.06]"></div>

  <div class="relative mx-auto max-w-content px-6 lg:px-10">
    <nav aria-label={t('common.breadcrumb')} class="mb-8">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-white/40">
        <li>
          <a href={path(lang, '/')} class="transition-colors hover:text-gold-400">
            {t('common.home')}
          </a>
        </li>
        {
          crumbs.map((crumb, index) => (
            <>
              <li aria-hidden="true" class="text-white/20">
                /
              </li>
              <li>
                {crumb.href && index < crumbs.length - 1 ? (
                  <a href={crumb.href} class="transition-colors hover:text-gold-400">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-white/70" aria-current="page">
                    {crumb.label}
                  </span>
                )}
              </li>
            </>
          ))
        }
      </ol>
    </nav>

    {
      eyebrow && (
        <div class="reveal mb-6 flex items-center gap-3">
          <span class="h-px w-10 shrink-0 bg-gold-500" />
          <span class="eyebrow text-xs font-semibold uppercase tracking-[0.22em] text-gold-400">
            {eyebrow}
          </span>
        </div>
      )
    }

    <h1
      class="reveal max-w-4xl font-serif text-4xl font-semibold leading-[1.1] tracking-[-0.02em] text-white lg:text-[3.4rem]"
      set:html={titleHtml ?? title}
    />

    {lead && <p class="reveal mt-7 max-w-2xl text-lg leading-relaxed text-white/60">{lead}</p>}

    <slot />
  </div>
</section>
