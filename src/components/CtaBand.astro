---
/** The closing "request a valuation" band used at the foot of inner pages. */
import Icon from './Icon.astro';
import { path, useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  title?: string;
  desc?: string;
}

const { lang, title, desc } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-sand py-20 lg:py-24">
  <div class="mx-auto max-w-content px-6 lg:px-10">
    <div
      class="reveal relative flex flex-col items-start justify-between gap-8 overflow-hidden rounded-3xl bg-navy-900 p-10 lg:flex-row lg:items-center lg:p-14"
    >
      <div class="barcode barcode-soft pointer-events-none absolute right-0 top-0 h-full w-1/4 text-gold-500 opacity-[0.07]"></div>

      <div class="relative max-w-xl">
        <h2 class="font-serif text-3xl font-semibold leading-tight text-white lg:text-4xl">
          {title ?? t('leadership.cta.title')}
        </h2>
        <p class="mt-4 leading-relaxed text-white/60">{desc ?? t('leadership.cta.desc')}</p>
      </div>

      <a
        href={path(lang, '/contact')}
        class="group relative inline-flex shrink-0 items-center justify-center gap-2.5 rounded-full bg-gold-500 px-8 py-4 font-semibold text-navy-900 transition-all hover:bg-gold-400 hover:shadow-xl hover:shadow-gold-500/25"
      >
        {t('common.requestValuation')}
        <Icon name="arrow-right" class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
