---
/**
 * Homepage hero — position, promise, and the standards trust strip.
 *
 * Photography is optional: when site.json → images.hero is empty the hero falls
 * back to the navy gradient and barcode motif, which reads as a deliberate
 * design rather than a missing asset.
 */
import Icon from '../Icon.astro';
import { getStandards, site } from '../../lib/content';
import { path, pick, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const standards = await getStandards();
const heroImage = site.images.hero;
const heroAlt = pick(site.images.heroAlt, lang);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<section
  id="top"
  class="relative flex min-h-[92vh] items-center overflow-hidden bg-navy-900 lg:min-h-screen"
>
  <div class="absolute inset-0">
    {
      heroImage && (
        <img
          src={`${base}${heroImage}`}
          alt={heroAlt}
          class="h-full w-full object-cover opacity-35"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-br from-navy-900 via-navy-900/92 to-navy-800/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-transparent to-navy-900/60"></div>
  </div>

  <div
    class="barcode barcode-soft pointer-events-none absolute right-0 top-0 hidden h-full w-1/3 text-gold-500 opacity-[0.07] lg:block"
  >
  </div>

  <div class="relative mx-auto w-full max-w-content px-6 pb-20 pt-28 lg:px-10">
    <div class="max-w-3xl">
      <div class="reveal mb-7 flex items-center gap-3">
        <span class="h-px w-10 shrink-0 bg-gold-500"></span>
        <span class="eyebrow text-xs font-semibold uppercase tracking-[0.22em] text-gold-400">
          {t('hero.eyebrow')}
        </span>
      </div>

      <h1
        class="reveal font-serif text-[2.6rem] font-semibold leading-[1.08] tracking-[-0.02em] text-white sm:text-6xl lg:text-[4.4rem]"
        set:html={t('hero.titleHtml')}
      />

      <p
        class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-white/70 lg:text-xl"
        set:html={t('hero.subHtml')}
      />

      <div class="reveal mt-11 flex flex-col gap-4 sm:flex-row">
        <a
          href={path(lang, '/contact')}
          class="group inline-flex items-center justify-center gap-2.5 rounded-full bg-gold-500 px-8 py-4 font-semibold text-navy-900 transition-all hover:bg-gold-400 hover:shadow-xl hover:shadow-gold-500/25"
        >
          <span>{t('common.requestValuation')}</span>
          <Icon name="arrow-right" class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" />
        </a>
        <a
          href={path(lang, '/services')}
          class="inline-flex items-center justify-center gap-2.5 rounded-full border border-white/25 px-8 py-4 font-semibold text-white transition-all hover:border-white/40 hover:bg-white/10"
        >
          {t('common.exploreServices')}
        </a>
      </div>

      <div class="reveal mt-16 border-t border-white/10 pt-8">
        <p class="microlabel mb-4 text-[11px] uppercase tracking-[0.18em] text-white/40">
          {t('hero.trust')}
        </p>
        <ul class="flex flex-wrap items-center gap-x-8 gap-y-3">
          {
            standards.map((standard, index) => (
              <>
                {index > 0 && <li aria-hidden="true" class="h-4 w-px bg-white/15" />}
                <li class="font-serif text-lg font-semibold text-white/75">
                  {standard.data.abbr === 'IVSC' ? 'IVS' : standard.data.abbr}
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <a
    href="#stats"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-white/35 transition-colors hover:text-gold-400 lg:flex"
  >
    <span class="microlabel text-[10px] uppercase tracking-[0.2em]">{t('hero.scroll')}</span>
    <svg
      class="motion-safe-only h-4 w-4 animate-bounce"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path stroke-linecap="round" d="M12 5v14m0 0-6-6m6 6 6-6" />
    </svg>
  </a>
</section>
