---
/**
 * "Cambodia rooted · Asia connected".
 *
 * ⚠ VERIFY BEFORE LAUNCH (Open Question #1): this section states that APP is
 * the Cambodia practice of the Twin Pillars network. That is sourced from
 * twinpillars.asia's own Team Asia page, which lists Mr. Sorn Seap as Managing
 * Director, Cambodia — it is NOT sourced from APP. Confirm the exact nature and
 * preferred wording of the relationship, and that Twin Pillars is happy to be
 * named, before publishing.
 *
 * If it cannot be confirmed, set `features.network` to false in site.json: this
 * section, its page, its nav entries and the "6 Asian markets" statistic all
 * disappear together, and nothing else breaks.
 */
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getNetwork } from '../../lib/content';
import { pick, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
  showHeading?: boolean;
}

const { lang, showHeading = true } = Astro.props;
const t = useTranslations(lang);

const markets = await getNetwork();
const home = markets.find((m) => m.data.isHome);
const others = markets.filter((m) => !m.data.isHome);
---

{
  markets.length > 0 && (
    <section id="network" class="relative overflow-hidden bg-sand py-24 lg:py-36">
      <div class="mx-auto max-w-content px-6 lg:px-10">
        <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-5">
            {showHeading && (
              <SectionHeading
                eyebrow={t('network.eyebrow')}
                titleHtml={t('network.titleHtml')}
                subHtml={t('network.p1Html')}
              />
            )}

            <p class="reveal mt-5 leading-relaxed text-slate-500">{t('network.p2')}</p>

            <div class="reveal mt-9 flex items-center gap-5 rounded-2xl border border-navy-900/[0.07] bg-white p-5">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-navy-900">
                <Icon name="globe" class="w-5 h-5 text-gold-500" />
              </div>
              <p class="text-sm leading-relaxed text-slate-500" set:html={t('network.noteHtml')} />
            </div>
          </div>

          <div class="lg:col-span-7">
            <ul class="grid gap-3.5 sm:grid-cols-2">
              {home && (
                <li class="reveal relative overflow-hidden rounded-2xl bg-navy-900 p-7 sm:col-span-2">
                  <div class="barcode barcode-soft absolute right-0 top-0 h-full w-24 text-gold-500 opacity-10" />
                  <div class="relative flex items-start justify-between gap-4">
                    <div>
                      <p class="mb-2 flex items-center gap-2.5">
                        <span class="motion-safe-only h-2 w-2 shrink-0 animate-pulse rounded-full bg-gold-500" />
                        <span class="microlabel text-[10px] font-bold uppercase tracking-[0.18em] text-gold-500">
                          {t('network.here')}
                        </span>
                      </p>
                      <h3 class="font-serif text-2xl font-semibold text-white">
                        {pick(home.data.country, lang)}
                      </h3>
                      <p class="mt-1.5 text-sm text-white/50">{pick(home.data.practice, lang)}</p>
                      {pick(home.data.lead, lang) && (
                        <p class="mt-3 text-xs text-white/40">{pick(home.data.lead, lang)}</p>
                      )}
                    </div>
                    <span class="microlabel shrink-0 rounded-full bg-gold-500 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-navy-900">
                      {t('network.ourPractice')}
                    </span>
                  </div>
                </li>
              )}

              {others.map((market, index) => (
                <li
                  class:list={[
                    'reveal rounded-2xl border border-navy-900/[0.07] bg-white p-6 transition-all hover:border-gold-500/50 hover:shadow-lg',
                    index === others.length - 1 && others.length % 2 === 1 && 'sm:col-span-2',
                  ]}
                >
                  <div class="mb-2.5 flex items-center gap-2.5">
                    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400" />
                    <h3 class="font-serif text-lg font-semibold">{pick(market.data.country, lang)}</h3>
                    {market.data.isHQ && (
                      <span class="rounded bg-gold-500/10 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-gold-600">
                        {t('network.hq')}
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-slate-500">{pick(market.data.specialism, lang)}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
