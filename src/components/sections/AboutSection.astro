---
/**
 * "Why APP" — four differentiators plus the founding-values pull quote.
 *
 * ⚠ TODO (content plan, sheet 11 — Open Questions): the pull quote paraphrases
 * the values copy on app-appraisal.com/about-us. Confirm the exact wording and
 * attribute it to a named individual, or drop the quotation marks.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

import { site } from '../../lib/content';
import { pick, useTranslations, type Locale, type UIKey } from '../../i18n/utils';

interface Props {
  lang: Locale;
  /** Hide the intro column on the About page, where it would repeat the hero. */
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;
const t = useTranslations(lang);

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const aboutImage = site.images.about;
const aboutAlt = pick(site.images.aboutAlt, lang);

/**
 * The four differentiators. Copy lives in the i18n files, keyed `about.pN.*`;
 * only the icon pairing is decided here.
 *
 * The keys are typed as `UIKey` up here on purpose — a generic cast written
 * inside the template below would be parsed as JSX by the Astro compiler.
 */
const pillars: { icon: IconName; titleKey: UIKey; descKey: UIKey }[] = [
  { icon: 'database', titleKey: 'about.p1.title', descKey: 'about.p1.desc' },
  { icon: 'shield-check', titleKey: 'about.p2.title', descKey: 'about.p2.desc' },
  { icon: 'users', titleKey: 'about.p3.title', descKey: 'about.p3.desc' },
  { icon: 'building', titleKey: 'about.p4.title', descKey: 'about.p4.desc' },
];
---

<section id="about" class="bg-white py-24 lg:py-36">
  <div class="mx-auto max-w-content px-6 lg:px-10">
    <div class="grid items-start gap-14 lg:grid-cols-12 lg:gap-20">
      {
        !compact && (
          <div class="lg:sticky lg:top-32 lg:col-span-5">
            <SectionHeading
              size="compact"
              eyebrow={t('about.eyebrow')}
              titleHtml={t('about.titleHtml')}
              sub={t('about.lead')}
            />

            {aboutImage && (
              <div class="reveal mt-10 overflow-hidden rounded-2xl">
                <img
                  src={`${base}${aboutImage}`}
                  alt={aboutAlt}
                  class="h-64 w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        )
      }

      <div class:list={['space-y-12', compact ? 'lg:col-span-12' : 'lg:col-span-7']}>
        <p
          class="reveal text-lg leading-relaxed text-navy-900/85 lg:text-xl"
          set:html={t('about.bodyHtml')}
        />

        <div class="grid gap-x-10 gap-y-10 pt-2 sm:grid-cols-2">
          {
            pillars.map((pillar) => (
              <div class="reveal">
                <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-xl bg-navy-900">
                  <Icon name={pillar.icon} class="w-5 h-5 text-gold-500" />
                </div>
                <h3 class="mb-2.5 font-serif text-xl font-semibold">
                  {t(pillar.titleKey)}
                </h3>
                <p class="leading-relaxed text-slate-500">
                  {t(pillar.descKey)}
                </p>
              </div>
            ))
          }
        </div>

        <blockquote class="reveal relative mt-4 rounded-2xl border-l-2 border-gold-500 bg-sand p-8 lg:p-10">
          <p class="font-serif text-xl italic leading-relaxed text-navy-900 lg:text-2xl">
            {t('about.quote')}
          </p>
          <footer class="mt-5 text-sm text-slate-500" set:html={t('about.quoteAttrHtml')} />
        </blockquote>
      </div>
    </div>
  </div>
</section>
