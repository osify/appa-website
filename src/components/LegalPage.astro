---
/**
 * Shared rendering for /terms and /privacy.
 *
 * Both documents need legal input (content plan, sheet 1). Until the Markdown
 * file exists the page renders a short, honest placeholder — the footer links
 * to these pages on every page of the site, so they must never 404.
 */
import { render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { getLegalPage, site } from '../lib/content';
import { formatDate } from '../lib/dates';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  slug: 'terms' | 'privacy';
  route: string;
  title: string;
  description: string;
  crumbLabel: string;
}

const { lang, slug, route, title, description, crumbLabel } = Astro.props;
const t = useTranslations(lang);

const document = await getLegalPage(lang, slug);
const Content = document ? (await render(document.entry)).Content : null;

const updated = document?.entry.data.updatedDate
  ? formatDate(document.entry.data.updatedDate, lang, {
      khmerNumerals: site.khmer.useKhmerNumerals,
    })
  : null;
---

<BaseLayout lang={lang} route={route} title={title} description={description} noindex>
  <PageHero
    lang={lang}
    title={document?.entry.data.title ?? crumbLabel}
    lead={document?.entry.data.description || undefined}
    crumbs={[{ label: crumbLabel }]}
  />

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-3xl px-6 lg:px-10">
      {
        document?.isFallback && (
          <p class="mb-8 rounded-xl border border-gold-500/30 bg-gold-500/10 px-5 py-4 text-sm text-navy-900">
            This document has not been translated yet and is shown in English.
          </p>
        )
      }

      {
        Content ? (
          <div class="prose-app">
            <Content />
          </div>
        ) : (
          <div class="rounded-3xl border border-dashed border-navy-900/15 bg-sand p-10">
            <p class="font-serif text-xl text-navy-900">
              This document is being prepared and will be published shortly.
            </p>
            <p class="mt-3 text-slate-500">
              In the meantime, please contact us at
              <a
                href={`mailto:${site.contact.email}`}
                class="font-medium text-navy-900 underline decoration-gold-500 underline-offset-4"
              >
                {site.contact.email}
              </a>
              with any question about how we handle your information.
            </p>
          </div>
        )
      }

      {
        updated && (
          <p class="mt-10 border-t border-navy-900/[0.08] pt-6 text-sm text-slate-400">
            {t('news.updated')}: {updated}
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
