---
/**
 * The APP wordmark — the supplied artwork, in two layers.
 *
 * The master file (public/images/logo/app-appraisal-logo.png) has a black
 * barcode, which disappears on the dark hero and footer. So it is split into
 * two same-sized layers stacked on top of each other:
 *   • app-mark.png    — the gold pill with "APP", drawn as a normal image;
 *   • app-barcode.png — the barcode and "APPRAISAL", used as a CSS mask over
 *     `currentColor`.
 *
 * The barcode therefore still inherits `currentColor`, so the colour is set
 * once by whatever wraps this component. That is what lets the header recolour
 * the mark with a single class as it scrolls from transparent to solid.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const barcode = `url(${base}/images/logo/app-barcode.png)`;
---

<span class:list={['flex flex-col items-center', className]}>
  <span class="relative block aspect-[3806/1929] w-[5.5rem] lg:w-24">
    <img
      src={`${base}/images/logo/app-mark.png`}
      alt="APP Appraisal"
      width="600"
      height="304"
      class="absolute inset-0 h-full w-full"
      decoding="async"
    />
    <span
      aria-hidden="true"
      class="absolute inset-0 bg-current transition-colors duration-500"
      style={`-webkit-mask: ${barcode} center / contain no-repeat; mask: ${barcode} center / contain no-repeat;`}
    ></span>
  </span>
</span>
