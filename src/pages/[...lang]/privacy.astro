---
import LegalPage from '../../components/LegalPage.astro';
import { localePaths, resolveLocale, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return localePaths();
}

const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);
---

<LegalPage
  lang={lang}
  slug="privacy"
  route="/privacy"
  title={t('meta.privacy.title')}
  description={t('meta.privacy.description')}
  crumbLabel={t('footer.privacy')}
/>
