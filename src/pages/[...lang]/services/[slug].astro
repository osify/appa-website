---
/**
 * A service detail page — one per service, per language:
 *   /services/real-estate  ·  /km/services/real-estate
 *
 * Everything on the page comes from the matching entry in
 * src/data/services.json, so adding a fourth service is a data edit, not a
 * code change: add the object and its page, nav entry, footer link, homepage
 * card and enquiry-form option all appear.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import StandardsSection from '../../../components/sections/StandardsSection.astro';

import { getServices } from '../../../lib/content';
import { LOCALES, DEFAULT_LOCALE, path, pick, pickList, resolveLocale, useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  const services = await getServices();

  return LOCALES.flatMap((locale) =>
    services.map((service) => ({
      params: {
        lang: locale === DEFAULT_LOCALE ? undefined : locale,
        slug: service.id,
      },
      props: { service },
    })),
  );
}

const { service } = Astro.props;
const lang = resolveLocale(Astro.params.lang);
const t = useTranslations(lang);

const name = pick(service.data.name, lang);
const summary = pick(service.data.summary, lang);
const intro = pick(service.data.intro, lang);
const assetTypes = pickList(service.data.assetTypes, lang);
const purposes = pickList(service.data.purposes, lang);
const route = `/services/${service.id}`;

const others = (await getServices()).filter((s) => s.id !== service.id);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<BaseLayout
  lang={lang}
  route={route}
  title={`${name} | ${t('meta.services.title').split('|')[1]?.trim() ?? 'APP Appraisal'}`}
  description={summary}
>
  <PageHero
    lang={lang}
    eyebrow={t('services.eyebrow')}
    title={name}
    lead={summary}
    crumbs={[{ label: t('nav.services'), href: path(lang, '/services') }, { label: name }]}
  />

  <section class="bg-white py-20 lg:py-28">
    <div class="mx-auto max-w-content px-6 lg:px-10">
      <div class="grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-7">
          <p class="reveal text-lg leading-relaxed text-navy-900/85 lg:text-xl">{intro}</p>

          {
            service.data.image && (
              <div class="reveal mt-10 overflow-hidden rounded-2xl">
                <img
                  src={`${base}${service.data.image}`}
                  alt={pick(service.data.imageAlt, lang)}
                  class="h-72 w-full object-cover lg:h-96"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )
          }
        </div>

        <div class="lg:col-span-5">
          <div class="reveal rounded-3xl bg-sand p-8 lg:p-10">
            {
              assetTypes.length > 0 && (
                <div>
                  <h2 class="microlabel mb-4 text-[10px] font-bold uppercase tracking-[0.18em] text-gold-600">
                    {t('services.assetTypes')}
                  </h2>
                  <ul class="flex flex-wrap gap-2">
                    {assetTypes.map((type) => (
                      <li class="rounded-full border border-navy-900/10 bg-white px-3.5 py-1.5 text-sm text-navy-900">
                        {type}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              purposes.length > 0 && (
                <div class="mt-9 border-t border-navy-900/[0.08] pt-8">
                  <h2 class="microlabel mb-4 text-[10px] font-bold uppercase tracking-[0.18em] text-gold-600">
                    {t('services.purposes')}
                  </h2>
                  <ul class="space-y-3">
                    {purposes.map((purpose) => (
                      <li class="flex gap-3 text-slate-500">
                        <Icon name="shield-check" class="w-4 h-4 shrink-0 mt-1 text-gold-500" />
                        <span>{purpose}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <a
              href={path(lang, '/contact')}
              class="group mt-9 inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-navy-900 px-6 py-4 font-semibold text-white transition-all hover:bg-navy-800"
            >
              {t('common.requestValuation')}
              <Icon name="arrow-right" class="w-4 h-4 shrink-0 transition-transform group-hover:translate-x-1" />
            </a>
          </div>
        </div>
      </div>

      {
        others.length > 0 && (
          <div class="mt-20 border-t border-navy-900/[0.08] pt-12">
            <h2 class="reveal mb-8 font-serif text-2xl font-semibold">{t('services.otherServices')}</h2>
            <ul class="grid gap-5 sm:grid-cols-2">
              {others.map((other) => (
                <li class="reveal group relative rounded-2xl border border-navy-900/[0.07] bg-white p-7 transition-all hover:border-gold-500/50 hover:shadow-lg">
                  <h3 class="font-serif text-xl font-semibold text-navy-900">
                    <a
                      href={path(lang, `/services/${other.id}`)}
                      class="after:absolute after:inset-0 after:content-['']"
                    >
                      {pick(other.data.name, lang)}
                    </a>
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-500">
                    {pick(other.data.summary, lang)}
                  </p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-navy-900 transition-colors group-hover:text-gold-600">
                    {t('common.learnMore')}
                    <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <StandardsSection lang={lang} />
  <CtaBand lang={lang} />
</BaseLayout>
